FLASK_SECRET_KEY = flask_secret_key
POSTGRES_USER= postgres_user
POSTGRES_PASSWORD = postgres_pass
POSTGRES_DB = students
PGWEB_DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@database:5432/${POSTGRES_DB}?sslmode=disable
REDIS_PASSWORD = redis_pass
GF_AUTH_ANONYMOUS_ENABLED=true
GF_AUTH_ANONYMOUS_ORG_ROLE = Admin
GF_LOG_LEVEL = error
DATA_SOURCE_NAME = postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@database:5432/${POSTGRES_DB}?sslmode=disable
REDIS_ADDR = redis://redis:6379
GF_SERVER_ROOT_URL=http://localhost/grafana
GF_SERVER_SERVE_FROM_SUB_PATH=true